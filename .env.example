# ==============================================================================
# Waggle Autonomous Launch Research - Environment Variables Template (.env.example)
# ==============================================================================

# 1. DATABASE & PERSISTENCE (Prisma Postgres / PostgreSQL + TimescaleDB)
DATABASE_URL="postgres://user:password@host:5432/postgres?sslmode=require"
DIRECT_URL="postgres://user:password@host:5432/postgres?sslmode=require"

# 2. QUEUE & SCHEDULING (Redis / BullMQ)
REDIS_URL="redis://default:redis_password@localhost:6379"

# 3. AI / LLM CLASSIFIER (OpenAI / Xiaomi Mimo / Anthropic Dedicated Protocol)
OPENAI_API_BASE_URL="https://token-plan-sgp.xiaomimimo.com/v1"
OPENAI_API_KEY="tp-sc12cu-your-mimo-key-here"
OPENAI_MODEL="gpt-4o-mini"

# 4. BLOCKCHAIN RPC ENDPOINTS & DEDICATED KEYS (Self-Indexing RPC Event Listeners)
# 4.1 Solana RPC (Helius High-Throughput RPC vs Standard Solana RPC)
SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"
HELIUS_API_KEY="a125f85c-5b7d-4409-b880-70e87cc93592"

# 4.2 EVM RPC Endpoints (Base, BNB, Robinhood Chain, Arc Chain)
BASE_EVM_RPC_URL="https://mainnet.base.org"
BNB_EVM_RPC_URL="https://bsc-dataseed.binance.org"
ROBINHOOD_RPC_URL="https://rpc.robinhoodchain.org"
ARC_RPC_URL="https://rpc.testnet.arc.network"
ARC_CHAIN_ID="5042002"
ALCHEMY_API_KEY="your-alchemy-api-key-here"

# 5. UPSTREAM DATA PROVIDER KEYS (Optional High-Rate Tier Keys)
GECKOTERMINAL_API_BASE_URL="https://api.geckoterminal.com/api/v2"
DEFILLAMA_API_BASE_URL="https://api.llama.fi"
DEXSCREENER_API_BASE_URL="https://api.dexscreener.com/latest/dex"
BIRDEYE_API_KEY="d13816101a2248e09806549f2278d053"

# 6. APP CONFIGURATION & DRIFT ALERTS
NEXT_PUBLIC_APP_URL="http://localhost:3000"
METRICS_RECOMPUTE_INTERVAL_SECONDS="3600"
METRICS_DRIFT_ALERT_THRESHOLD_PCT="20"
